    {"id": "no-smoothing", "mode": "class-aware", "parameters": {"alpha": 1}},
    {"id": "no-hysteresis", "mode": "class-aware", "parameters": {"threshold": 0}},
    {"id": "no-dwell", "mode": "class-aware", "parameters": {"dwell": 0}},
    {"id": "shared-objective", "mode": "stable"}
  ]
